@page "/team"
@inherits MementoMori.BlazorShared.Models.AccountComponent
@using MementoMori.Funcs
@using MementoMori.Ortega.Custom
@using MementoMori.Ortega.Share.Data.DtoInfo
@using MementoMori.BlazorShared.Components
@using static MementoMori.Ortega.Share.Masters
@using DynamicData.Binding
@implements IDisposable

<PageTitle>Team & tiers</PageTitle>

@if (!Funcs.LoginOk || Funcs.UserSyncData?.UserCharacterDtoInfos == null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Waiting for login…</MudAlert>
}
else
{
    var sync = Funcs.UserSyncData;
    var team = Funcs.GetMainTeam().Select(c => c.Guid).ToHashSet();
    var recommended = Funcs.GetRecommendedTeam();
    var roster = Roster();

    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText>Recommended team</MudText>
                        <MudText Typo="Typo.caption" Class="mm-muted">Best 5 you own by tier → rarity → level. The bot sets this as your quest team when “Auto build team” is on.</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Groups" Disabled="@Funcs.IsQuickActionExecuting" OnClick="Funcs.AutoBuildTeam">Use this team</MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <div class="mm-team">
                        @foreach (var c in recommended)
                        {
                            <div class="mm-team-member">
                                <CharacterIcon UserCharacterInfo="sync.GetUserCharacterInfoByUserCharacterDtoInfo(c)" Size="76"/>
                                <div class="mm-team-name">@MementoMoriFuncs.CharName(c.CharacterId)</div>
                                <MudStack Row="true" Spacing="1" Justify="Justify.Center">
                                    <TierBadge Tier="@Funcs.GetTier(c.CharacterId)"/>
                                    @if (team.Contains(c.Guid))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">in team</MudChip>
                                    }
                                </MudStack>
                            </div>
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText>Your characters (@roster.Count)</MudText>
                        <MudText Typo="Typo.caption" Class="mm-muted">Tiers come from the community list; change any of them and the bot (team, leveling, gacha) follows your call.</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudTextField T="string" @bind-Value="_search" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" Style="min-width:200px"/>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="roster" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" Filter="Matches">
                        <HeaderContent>
                            <MudTh></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<UserCharacterDtoInfo, object>(c => MementoMoriFuncs.CharName(c.CharacterId))">Character</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel InitialDirection="MudBlazor.SortDirection.Descending" SortBy="new Func<UserCharacterDtoInfo, object>(c => Funcs.TierScore(c.CharacterId))">Tier</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<UserCharacterDtoInfo, object>(c => c.RarityFlags)">Rarity</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<UserCharacterDtoInfo, object>(c => Funcs.GetEffectiveLevel(c))">Level</MudTableSortLabel></MudTh>
                            <MudTh>Role</MudTh>
                            <MudTh>Notes</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{ var entry = MementoMoriFuncs.GetBuiltinTierEntry(context.CharacterId); }
                            <MudTd><CharacterIcon UserCharacterInfo="sync.GetUserCharacterInfoByUserCharacterDtoInfo(context)" Size="44"/></MudTd>
                            <MudTd DataLabel="Character">
                                <b>@MementoMoriFuncs.CharName(context.CharacterId)</b>
                                @if (team.Contains(context.Guid)) { <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">team</MudChip> }
                                @if (sync.IsLevelLinkMember(context.Guid)) { <MudIcon Icon="@Icons.Material.Rounded.Link" Size="Size.Small" Color="Color.Tertiary" Title="Level Link"/> }
                            </MudTd>
                            <MudTd DataLabel="Tier">
                                <MudSelect T="string" Value="@Funcs.GetTier(context.CharacterId)" ValueChanged="t => SetTier(context.CharacterId, t)" Dense="true" Margin="Margin.Dense" Variant="Variant.Text" Style="max-width:84px"
                                           Placeholder="—" Clearable="true" Class="@(Funcs.IsTierOverridden(context.CharacterId) ? "mm-overridden" : "")">
                                    @foreach (var t in MementoMoriFuncs.Tiers) { <MudSelectItem Value="t">@t</MudSelectItem> }
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Rarity">@context.RarityFlags</MudTd>
                            <MudTd DataLabel="Level">@Funcs.GetEffectiveLevel(context)</MudTd>
                            <MudTd DataLabel="Role">@entry?.Role</MudTd>
                            <MudTd DataLabel="Notes"><span class="mm-muted">@entry?.Notes</span></MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    string _search = "";
    IDisposable? _sub;

    // 每个角色只显示稀有度最高的那张
    List<UserCharacterDtoInfo> Roster() => Funcs.UserSyncData.UserCharacterDtoInfos
        .GroupBy(c => c.CharacterId).Select(g => g.MaxBy(c => c.RarityFlags)!)
        .OrderByDescending(c => Funcs.TierScore(c.CharacterId)).ThenByDescending(c => c.RarityFlags).ThenByDescending(c => c.Level).ToList();

    bool Matches(UserCharacterDtoInfo c) => string.IsNullOrWhiteSpace(_search) || MementoMoriFuncs.CharName(c.CharacterId).Contains(_search, StringComparison.OrdinalIgnoreCase);

    void SetTier(long characterId, string? tier)
    {
        Funcs.SetTier(characterId, tier);
        StateHasChanged();
    }

    protected override Task AccountChanged()
    {
        _sub?.Dispose();
        _sub = Funcs.WhenAnyPropertyChanged().Subscribe(_ => InvokeAsync(StateHasChanged));
        return Task.CompletedTask;
    }

    public void Dispose() => _sub?.Dispose();
}
